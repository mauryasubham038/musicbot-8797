API_ID=
API_HASH=
BOT_TOKEN=
# Assistant (dusra Telegram account) ka Pyrogram session string - VC me yehi account gaana bajata hai
SESSION_STRING=
# Aapki Telegram user id (comma se alag karke kai owner)
OWNER_IDS=
# Optional: error logs ke liye private group/channel id (bot ko admin banao)
LOG_CHAT_ID=
# Optional: YouTube "sign in to confirm" error aaye to cookies.txt ka path
COOKIES_FILE=
DB_PATH=musicbot.db
# Render par disk lo to DB_PATH=/data/musicbot.db aur SESSION_DIR=/data
SESSION_DIR=.
POOL_REFRESH_MINUTES=60
QUERIES_PER_REFRESH=12
MAX_SONG_MINUTES=10
